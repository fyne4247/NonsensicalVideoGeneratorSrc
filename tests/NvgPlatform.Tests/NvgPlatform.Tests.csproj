<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);DESKTOPGL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <!--
    The game project is net8.0-windows unless NvgPlatform=DesktopGL, and NuGet restore
    ignores that switch on a ProjectReference. Compile the platform sources here so
    `dotnet test` covers them on macOS and Linux. The game build is a separate step.
  -->
  <ItemGroup>
    <Compile Include="..\PosixFactAttribute.cs" Link="PosixFactAttribute.cs" />
    <Compile Include="..\..\src\backend\platform\AudioOutputFollower.cs" Link="platform\AudioOutputFollower.cs" />
    <Compile Include="..\..\src\backend\platform\AppPaths.cs" Link="platform\AppPaths.cs" />
    <Compile Include="..\..\src\backend\platform\AppRestart.cs" Link="platform\AppRestart.cs" />
    <Compile Include="..\..\src\backend\platform\AudioDiagnostics.cs" Link="platform\AudioDiagnostics.cs" />
    <Compile Include="..\..\src\backend\platform\DataRoots.cs" Link="platform\DataRoots.cs" />
    <Compile Include="..\..\src\backend\platform\NativeCommand.cs" Link="platform\NativeCommand.cs" />
    <Compile Include="..\..\src\backend\platform\NvgPaths.cs" Link="platform\NvgPaths.cs" />
    <Compile Include="..\..\src\backend\platform\PlatformClipboard.cs" Link="platform\PlatformClipboard.cs" />
    <Compile Include="..\..\src\backend\platform\PlatformFileDialog.cs" Link="platform\PlatformFileDialog.cs" />
    <Compile Include="..\..\src\backend\platform\ProcessTree.cs" Link="platform\ProcessTree.cs" />
    <Compile Include="..\..\src\backend\platform\PlatformShell.cs" Link="platform\PlatformShell.cs" />
    <Compile Include="..\..\src\backend\platform\PlatformTts.cs" Link="platform\PlatformTts.cs" />
    <Compile Include="..\..\src\backend\platform\ShutdownSignals.cs" Link="platform\ShutdownSignals.cs" />
    <Compile Include="..\..\src\backend\platform\AtomicDownload.cs" Link="platform\AtomicDownload.cs" />
    <Compile Include="..\..\src\backend\platform\PlatformUrl.cs" Link="platform\PlatformUrl.cs" />
    <Compile Include="..\..\src\backend\platform\DesktopFullscreen.cs" Link="platform\DesktopFullscreen.cs" />
    <Compile Include="..\..\src\data\BlogData.cs" Link="BlogData.cs" />
    <Compile Include="..\..\src\backend\platform\ToolPaths.cs" Link="platform\ToolPaths.cs" />
    <Compile Include="..\..\src\data\LibraryPathRules.cs" Link="LibraryPathRules.cs" />
  </ItemGroup>
</Project>
