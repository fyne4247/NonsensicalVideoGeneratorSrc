<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.8.3.0</Version>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <AssemblyName>NonsensicalVideoGenerator</AssemblyName>
    <AssemblyProduct>NonsensicalVideoGenerator</AssemblyProduct>
    <AssemblyTitle>Nonsensical Video Generator</AssemblyTitle>
    <RootNamespace>NonsensicalVideoGenerator</RootNamespace>
    <Authors>Bobby I Guess</Authors>
    <AssemblyCopyright>Copyright © Bobby I Guess 2026</AssemblyCopyright>
    <AssemblyTrademark>Nonsensical Video Generator licensed under GPL-3.0
MonoGame licensed under Ms-PL
Newtonsoft.Json licensed under MIT
Steamworks.NET licensed under MIT
DiscordRichPresence licensed under MIT
SharpCompress licensed under MIT
MoonSharp licensed under BSD-3-Clause
Sdcb.FFmpeg licensed under GPL-3.0
FFmpeg licensed under GPL-3.0 License
Munro licensed under SIL OFL
Noto Sans licensed under SIL OFL
LanaPixel licensed under SIL OFL</AssemblyTrademark>
    <Platforms>x64</Platforms>
    <ProjectGuid>{dddb8c0a-4f2d-4e5b-9a1c-3f7d6e0f1a2b}</ProjectGuid>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/NVGPartners/NonsensicalVideoGeneratorSrc.git</RepositoryUrl>
    <RepositoryBranch>dev</RepositoryBranch>
    <ApplicationHighDpiMode>true</ApplicationHighDpiMode>
    <CLSCompliant>false</CLSCompliant>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute> 
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>bin\x64\$(Configuration)\net8.0-windows</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <!-- DesktopGL trial switch. Unset NvgPlatform keeps the WindowsDX property groups above. -->
  <PropertyGroup Condition="'$(NvgPlatform)' == 'DesktopGL'">
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <!-- Preserve project-defined constants; the SDK adds DEBUG for Debug builds later.
         A command-line DefineConstants is a global override and must include DESKTOPGL itself. -->
    <DefineConstants>$(DefineConstants);TRACE;DESKTOPGL</DefineConstants>
    <DefineConstants Condition="'$(NvgSteam)' == 'true'">$(DefineConstants);NVG_STEAM</DefineConstants>
    <UseWindowsForms>false</UseWindowsForms>
    <TargetFramework>net8.0</TargetFramework>
    <OutputPath>bin/x64/$(Configuration)/net8.0-desktopgl/</OutputPath>
    <!-- Fail CoreCompile's dependency so NVG_STEAM stops before the C# compiler cascades. -->
    <CoreCompileDependsOn>RejectDesktopGLSteam;$(CoreCompileDependsOn)</CoreCompileDependsOn>
    <ApplicationManifest></ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NvgPlatform)' != 'DesktopGL'">
    <DefineConstants>WINDOWSDX</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!--
    The content task globs **/*.mgcb when EnableMGCBItems is left at the package
    default. That glob ignores the item conditions below and runs the native
    builder, which aborts on arm64 macOS (FreeImage / freetype). Turn the glob
    off and include one pipeline explicitly. tools/build-content-desktopgl.sh
    builds the DesktopGL content with the x64 SDK.
  -->
  <PropertyGroup>
    <EnableMGCBItems>false</EnableMGCBItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NvgPlatform)' == 'DesktopGL' and '$(NvgSkipMgcb)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()) == 'Arm64'">
    <NvgSkipMgcb>true</NvgSkipMgcb>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Xna.Framework.Content.ContentTypeReader" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="icon.ico" />
    <None Remove="icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="icon.ico">
      <LogicalName>icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon.bmp">
      <LogicalName>icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ExeWrapper/ExeWrapper.cs" />
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <!-- Generated AssemblyInfo under a DesktopGL obj tree must not be compiled again. -->
    <Compile Remove="obj-desktopgl*/**" />
    <None Remove="obj-desktopgl*/**" />
    <EmbeddedResource Remove="obj-desktopgl*/**" />
  </ItemGroup>
  <Target Name="RejectDesktopGLSteam" Condition="'$(NvgPlatform)' == 'DesktopGL' and ('$(NvgSteam)' == 'true' or $(DefineConstants.Contains('NVG_STEAM')))">
    <Error Text="NVG_STEAM is not supported on the DesktopGL build. Steam integration stays off. Unset NvgSteam / NVG_STEAM." />
  </Target>
  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
    <PackageReference Include="MonoGame.Extended" Version="4.0.2" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.2.1105" Condition="'$(NvgPlatform)' != 'DesktopGL'" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" Condition="'$(NvgPlatform)' == 'DesktopGL'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Speech" Version="8.0.0" Condition="'$(NvgPlatform)' != 'DesktopGL'" />
    <PackageReference Include="WindowsAPICodePack" Version="8.0.4" Condition="'$(NvgPlatform)' != 'DesktopGL'" />
  </ItemGroup>
  <ItemGroup Condition="'$(NvgPlatform)' != 'DesktopGL'">
   <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET" Condition="'$(NvgPlatform)' != 'DesktopGL'">
      <HintPath>packages\Steamworks.NET\Steamworks.NET.dll</HintPath>
    </Reference>
    <Reference Include="MoonSharp">
      <HintPath>packages\MoonSharp\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Extended2">
      <HintPath>packages\MonoGame.Extended2\MonoGame.Extended2.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Extended.VideoPlayback">
      <HintPath>packages\MonoGame.Extended.VideoPlayback\MonoGame.Extended.VideoPlayback.dll</HintPath>
    </Reference>
    <Reference Include="Sdcb.FFmpeg">
      <HintPath>packages\Sdcb.FFmpeg\Sdcb.FFmpeg.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="content\Content.mgcb" Condition="'$(NvgPlatform)' != 'DesktopGL'" />
    <MonoGameContentReference Include="content\Content.DesktopGL.mgcb" Condition="'$(NvgPlatform)' == 'DesktopGL' and '$(NvgSkipMgcb)' != 'true'" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
	<ItemGroup>
    <BasePlugins Include="$(ProjectDir)baseplugins\user\stock\**\*.*" />
    <WorkshopPlugins Include="$(ProjectDir)baseplugins\user\**\*.*" />
    <BaseTemplates Include="$(ProjectDir)basetemplates\**\*.*" />
    <BaseLocales Include="$(ProjectDir)public\locales\**\*.*" />
    <BaseRoot Include="$(ProjectDir)baseroot\**\*.*" />
    <BaseLayerGraphics Include="$(ProjectDir)content\graphics\**\*.*" />
    <BaseLayerSound Include="$(ProjectDir)content\sound\**\*.*" />
 	</ItemGroup>
	<Target Name="CopyPlugins" AfterTargets="Build" Condition="'$(NvgPlatform)' != 'DesktopGL'">
		<MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\plugins" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\library" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\library\audio" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\library\video" />
		<MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\plugins" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\library" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\library\audio" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\library\video" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\templates" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\templates" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Release\net8.0-windows\locales" />
    <MakeDir Directories="$(ProjectDir)bin\x64\Debug\net8.0-windows\locales" />
		<Copy SourceFiles="@(BasePlugins)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\plugins\user\stock\%(RecursiveDir)%(Filename)%(Extension)" />
		<Copy SourceFiles="@(WorkshopPlugins)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\plugins\user\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseTemplates)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\templates\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseTemplates)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\templates\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLocales)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\locales\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLocales)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\locales\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseRoot)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseRoot)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLayerGraphics)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\templates\defaultlayer\graphics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLayerGraphics)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\templates\defaultlayer\graphics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLayerSound)" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\templates\defaultlayer\sound\%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(BaseLayerSound)" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\templates\defaultlayer\sound\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- .\packages\Steamworks.NET\steam_api64.dll -->
    <Copy SourceFiles=".\packages\Steamworks.NET\steam_api64.dll" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\steam_api64.dll" />
    <Copy SourceFiles=".\packages\Steamworks.NET\steam_api64.dll" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\steam_api64.dll" />
    <!-- .\packages\MoonSharp\MoonSharp.Interpreter.dll -->
    <Copy SourceFiles=".\packages\MoonSharp\MoonSharp.Interpreter.dll" DestinationFiles="$(ProjectDir)bin\x64\Release\net8.0-windows\MoonSharp.Interpreter.dll" />
    <Copy SourceFiles=".\packages\MoonSharp\MoonSharp.Interpreter.dll" DestinationFiles="$(ProjectDir)bin\x64\Debug\net8.0-windows\MoonSharp.Interpreter.dll" />
	</Target>
  <!--
    Copy inside the target that sets the destination. A called target does not
    see that property, and an empty destination writes over the source tree.
  -->
  <Target Name="CopyPluginsDesktopGL" AfterTargets="Build" Condition="'$(NvgPlatform)' == 'DesktopGL'">
    <PropertyGroup>
      <_NvgCopyTo>$([MSBuild]::EnsureTrailingSlash($(OutDir)))</_NvgCopyTo>
    </PropertyGroup>
    <Error Condition="'$(_NvgCopyTo)' == '' Or '$([System.IO.Path]::GetFullPath($(_NvgCopyTo)))' == '$([System.IO.Path]::GetFullPath($(ProjectDir)))'" Text="DesktopGL payload destination must be the build output directory." />
    <ItemGroup>
      <DesktopGLPlugins Remove="@(DesktopGLPlugins)" />
      <DesktopGLTemplates Remove="@(DesktopGLTemplates)" />
      <DesktopGLLocales Remove="@(DesktopGLLocales)" />
      <DesktopGLRoot Remove="@(DesktopGLRoot)" />
      <DesktopGLGraphics Remove="@(DesktopGLGraphics)" />
      <DesktopGLSound Remove="@(DesktopGLSound)" />
      <DesktopGLContent Remove="@(DesktopGLContent)" />
      <DesktopGLPlugins Include="$(ProjectDir)baseplugins/user/**/*.*" />
      <DesktopGLTemplates Include="$(ProjectDir)basetemplates/**/*.*" />
      <DesktopGLLocales Include="$(ProjectDir)public/locales/**/*.*" />
      <DesktopGLRoot Include="$(ProjectDir)baseroot/**/*.*" />
      <DesktopGLGraphics Include="$(ProjectDir)content/graphics/**/*.*" />
      <DesktopGLSound Include="$(ProjectDir)content/sound/**/*.*" />
      <!-- Script output is Content/. The MGCB task names its folder after the mgcb file. -->
      <DesktopGLContent Include="$(ProjectDir)content/bin/DesktopGL/Content/**/*.*" />
      <DesktopGLContent Include="$(ProjectDir)content/bin/DesktopGL/Content.DesktopGL/**/*.*" Condition="!Exists('$(ProjectDir)content/bin/DesktopGL/Content')" />
    </ItemGroup>
    <MakeDir Directories="$(_NvgCopyTo)plugins;$(_NvgCopyTo)library/audio;$(_NvgCopyTo)library/video;$(_NvgCopyTo)templates;$(_NvgCopyTo)locales" />
    <Copy SourceFiles="@(DesktopGLPlugins)" DestinationFiles="$(_NvgCopyTo)plugins/user/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLTemplates)" DestinationFiles="$(_NvgCopyTo)templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLLocales)" DestinationFiles="$(_NvgCopyTo)locales/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLRoot)" DestinationFiles="$(_NvgCopyTo)%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLGraphics)" DestinationFiles="$(_NvgCopyTo)templates/defaultlayer/graphics/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLSound)" DestinationFiles="$(_NvgCopyTo)templates/defaultlayer/sound/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLContent)" DestinationFiles="$(_NvgCopyTo)Content/%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDesktopGLPublish" AfterTargets="Publish" Condition="'$(NvgPlatform)' == 'DesktopGL'">
    <PropertyGroup>
      <_NvgCopyTo>$([MSBuild]::EnsureTrailingSlash($(PublishDir)))</_NvgCopyTo>
    </PropertyGroup>
    <Error Condition="'$(_NvgCopyTo)' == '' Or '$([System.IO.Path]::GetFullPath($(_NvgCopyTo)))' == '$([System.IO.Path]::GetFullPath($(ProjectDir)))'" Text="DesktopGL publish payload destination must be the publish directory." />
    <ItemGroup>
      <DesktopGLPlugins Remove="@(DesktopGLPlugins)" />
      <DesktopGLTemplates Remove="@(DesktopGLTemplates)" />
      <DesktopGLLocales Remove="@(DesktopGLLocales)" />
      <DesktopGLRoot Remove="@(DesktopGLRoot)" />
      <DesktopGLGraphics Remove="@(DesktopGLGraphics)" />
      <DesktopGLSound Remove="@(DesktopGLSound)" />
      <DesktopGLContent Remove="@(DesktopGLContent)" />
      <DesktopGLPlugins Include="$(ProjectDir)baseplugins/user/**/*.*" />
      <DesktopGLTemplates Include="$(ProjectDir)basetemplates/**/*.*" />
      <DesktopGLLocales Include="$(ProjectDir)public/locales/**/*.*" />
      <DesktopGLRoot Include="$(ProjectDir)baseroot/**/*.*" />
      <DesktopGLGraphics Include="$(ProjectDir)content/graphics/**/*.*" />
      <DesktopGLSound Include="$(ProjectDir)content/sound/**/*.*" />
      <!-- Script output is Content/. The MGCB task names its folder after the mgcb file. -->
      <DesktopGLContent Include="$(ProjectDir)content/bin/DesktopGL/Content/**/*.*" />
      <DesktopGLContent Include="$(ProjectDir)content/bin/DesktopGL/Content.DesktopGL/**/*.*" Condition="!Exists('$(ProjectDir)content/bin/DesktopGL/Content')" />
    </ItemGroup>
    <MakeDir Directories="$(_NvgCopyTo)plugins;$(_NvgCopyTo)library/audio;$(_NvgCopyTo)library/video;$(_NvgCopyTo)templates;$(_NvgCopyTo)locales" />
    <Copy SourceFiles="@(DesktopGLPlugins)" DestinationFiles="$(_NvgCopyTo)plugins/user/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLTemplates)" DestinationFiles="$(_NvgCopyTo)templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLLocales)" DestinationFiles="$(_NvgCopyTo)locales/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLRoot)" DestinationFiles="$(_NvgCopyTo)%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLGraphics)" DestinationFiles="$(_NvgCopyTo)templates/defaultlayer/graphics/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLSound)" DestinationFiles="$(_NvgCopyTo)templates/defaultlayer/sound/%(RecursiveDir)%(Filename)%(Extension)" />
    <Copy SourceFiles="@(DesktopGLContent)" DestinationFiles="$(_NvgCopyTo)Content/%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Vendored Extended assemblies are IL-only but marked AMD64. arm64 CoreCLR refuses that machine id even when ILONLY is set. retarget-ilonly.py rewrites the output copies to I386 and leaves native images and the packages/ originals alone. -->
  <Target Name="RetargetIlOnlyAmd64" AfterTargets="CopyPluginsDesktopGL" Condition="'$(NvgPlatform)' == 'DesktopGL'">
    <Exec Command="python3 &quot;$(ProjectDir)src/backend/platform/retarget-ilonly.py&quot; &quot;$(TargetDir)&quot;" />
  </Target>
  <Target Name="RetargetIlOnlyAmd64Publish" AfterTargets="Publish" Condition="'$(NvgPlatform)' == 'DesktopGL'">
    <Exec Command="python3 &quot;$(ProjectDir)src/backend/platform/retarget-ilonly.py&quot; &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
